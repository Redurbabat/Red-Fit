{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RED Fit",
  "version": "0.1.0",
  "identifier": "com.redfit.desktop",
  "build": {
    "beforeDevCommand": "npm run desktop:icons && npm run dev -- --host 127.0.0.1",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm run desktop:icons && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "RED Fit",
        "width": 1180,
        "height": 800,
        "minWidth": 700,
        "minHeight": 540
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": [
      "msi",
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}
