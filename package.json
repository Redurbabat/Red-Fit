{
  "name": "red-fit",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "RED Fit — Training und Ernährung in einer App.",
  "scripts": {
    "dev": "vite",
    "dev:host": "vite --host",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "node tools/e2e-smoke.mjs",
    "desktop:icons": "node tools/prepare-windows-icons.mjs",
    "test:native-icons": "node --test tools/native-icons.selftest.mjs",
    "native:plan": "node tools/bootstrap-native.mjs --plan",
    "native:bootstrap": "node tools/bootstrap-native.mjs --install",
    "native:check": "node tools/bootstrap-native.mjs --check",
    "test:native-deps": "node --test tools/native-deps.selftest.mjs",
    "test:wger-catalog": "node --test tools/bundled-wger.selftest.mjs",
    "test:cooking-yield": "node --experimental-strip-types --test tools/cooking-yield.selftest.mjs",
    "test:meal-integrity": "node --experimental-strip-types --test tools/meal-entry-ops.selftest.mjs",
    "test:workout-save-queue": "node --experimental-strip-types --test tools/workout-save-queue.selftest.mjs",
    "test:workout-status": "node --experimental-strip-types --test tools/workout-status-guard.selftest.mjs",
    "test:workout-revision": "node --experimental-strip-types --test tools/workout-revision.selftest.mjs",
    "test:workout-start": "node --test tools/workout-start.selftest.mjs",
    "test:backup-size": "node --experimental-strip-types --test tools/backup-export-policy.selftest.mjs",
    "test:backup-snapshot": "node --test tools/backup-snapshot.selftest.mjs",
    "test:backup-workout-revision": "node --experimental-strip-types --test tools/backup-workout-revision.selftest.mjs",
    "test:backup-meal-collisions": "node --experimental-strip-types --test tools/backup-meal-merge.selftest.mjs"
  },
  "dependencies": {
    "@react-three/fiber": "^9.7.0",
    "dexie": "^4.0.11",
    "dexie-react-hooks": "^4.4.0",
    "lucide-react": "^0.544.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.8.2",
    "three": "^0.185.1",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@types/node": "^24.3.1",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "^5.0.2",
    "eslint": "^9.35.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "fake-indexeddb": "^6.0.1",
    "happy-dom": "^20.11.2",
    "playwright-core": "^1.62.1",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.42.0",
    "vite": "^7.1.4",
    "vite-plugin-pwa": "^1.0.3",
    "vitest": "^3.2.4"
  }
}
