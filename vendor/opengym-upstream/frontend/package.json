{
  "name": "red-fit-frontend",
  "private": true,
  "version": "1.4.4",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:mobile": "VITE_MOBILE=1 vite build && node ../scripts/catalogue/stage-media.mjs dist && cap sync && node scripts/check-mobile-bundle.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:fatigue-probe": "node scripts/fatigue-monotonic-probe.mjs",
    "pdf:check": "node scripts/pdf/render-samples.mjs --out pdf-samples --langs en,de,ar --paper A4,Letter --check",
    "ios:brand": "swift ios/ci/brand-red-fit.swift",
    "test:ios-identity": "node scripts/verify-ios-identity.mjs",
    "build:ios": "npm run ios:poses && VITE_MOBILE=1 vite build && node ../scripts/catalogue/stage-media.mjs dist && cap sync ios && ruby ios/ci/add-swiftui.rb && node scripts/verify-ios-private-deps.mjs && node scripts/check-ios-mobile-bundle.mjs && npm run ios:brand && npm run test:ios-identity",
    "test:ios-bundle": "node --test scripts/check-ios-mobile-bundle.test.mjs",
    "test:ios-identity-unit": "node --test scripts/verify-ios-identity.test.mjs",
    "brand:assets": "node scripts/app-icons.mjs && node scripts/brand-red-fit.mjs",
    "ios:poses": "node --experimental-strip-types scripts/native-poses.mjs"
  },
  "license": "AGPL-3.0-or-later",
  "dependencies": {
    "@aparajita/capacitor-secure-storage": "^8.0.1",
    "@capacitor-mlkit/barcode-scanning": "^8.2.1",
    "@capacitor/app": "^8.0.0",
    "@capacitor/core": "^8.5.3",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/local-notifications": "^8.0.0",
    "@capacitor/share": "^8.0.0",
    "@capacitor/splash-screen": "^8.0.2",
    "jsqr": "^1.4.0",
    "leaflet": "^1.9.4",
    "lean-qr": "^2.7.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/cli": "^8.5.3",
    "@capacitor/ios": "^8.5.3",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^4.1.12",
    "fake-indexeddb": "6.0.1",
    "fast-check": "^4.10.2",
    "happy-dom": "^20.14.6",
    "linkedom": "^0.18.13",
    "vite": "^8.3.4",
    "vitest": "^4.1.12"
  }
}
